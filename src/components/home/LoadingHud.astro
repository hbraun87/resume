---
/* The fixed loading HUD, the desktop asset stream, toasts and the finale
   flash. All hidden until the home page script runs. */
import profile from '../../content/profile.json';
---

<div class="hud" data-hud data-tips={JSON.stringify(profile.tips)} hidden>
  <div class="hud-inner">
    <p class="pct" aria-hidden="true">
      <span data-hud-pct>0</span>
      <span class="sign">%</span>
    </p>
    <div class="main">
      <p class="text mono">
        <span class="stage" data-hud-stage>
          Booting player profile
        </span>
        <span class="tip" data-hud-tip>
          {profile.tips[0]}
        </span>
      </p>
      <div
        class="bar"
        role="progressbar"
        aria-label="Page loaded"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-hud-bar
      >
        <span class="fill" data-hud-fill></span>
      </div>
    </div>
    <a class="cta mono" href="#contact">
      <span data-hud-cta>Loading…</span>
      <span class="visually-hidden"> Jump to contact</span>
    </a>
  </div>
</div>
<ol class="asset-log mono" data-asset-log aria-hidden="true"></ol>
<div class="toasts" role="status" data-toasts></div>
<div class="flash" data-flash aria-hidden="true"></div>

<style>
  .hud {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    padding-bottom: env(safe-area-inset-bottom);
    background: color-mix(in srgb, var(--ink) 92%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .hud[hidden] {
    display: none;
  }
  .hud-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: min(100% - 2 * var(--gutter), var(--content));
    height: 4rem;
    margin-inline: auto;
  }
  .pct {
    min-width: 3.4ch;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .sign {
    font-size: 0.55em;
    color: var(--dim);
  }
  .main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: var(--space-2);
  }
  .text {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    white-space: nowrap;
  }
  .stage {
    color: var(--bone);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tip {
    overflow: hidden;
    color: var(--dim);
    text-overflow: ellipsis;
    transition: opacity 0.25s ease;
  }
  .tip:global(.is-fading) {
    opacity: 0;
  }
  @media (max-width: 760px) {
    .tip {
      display: none;
    }
  }
  .bar {
    position: relative;
    height: 10px;
    background: var(--panel);
    border: 1px solid var(--line);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-45deg, var(--wolf) 0 8px, var(--wolf-deep) 8px 16px);
    background-size: 22.6px 22.6px;
    clip-path: inset(0 100% 0 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fill {
      animation: stripes 0.8s linear infinite;
    }
  }
  @keyframes stripes {
    to {
      background-position: 22.6px 0;
    }
  }
  .cta {
    display: inline-grid;
    place-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    color: var(--dim);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .cta {
      display: none;
    }
  }
  .hud:global(.is-done) {
    border-top-color: var(--wolf);
  }
  .hud:global(.is-done) .pct {
    color: var(--wolf);
  }
  .hud:global(.is-done) .fill {
    background: var(--wolf);
    animation: none;
  }
  .hud:global(.is-done) .cta {
    background: var(--wolf);
    border-color: var(--wolf);
    color: var(--on-wolf);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hud:global(.is-done) .cta {
      animation: pulse 1.6s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--wolf) 25%, transparent);
    }
  }
  .asset-log {
    position: fixed;
    right: var(--gutter);
    bottom: calc(4rem + env(safe-area-inset-bottom) + var(--space-3));
    z-index: 39;
    display: grid;
    justify-items: end;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 24rem;
    color: var(--dim);
    pointer-events: none;
  }
  .asset-log :global(li) {
    max-width: 100%;
    overflow: hidden;
    padding-inline: var(--space-1);
    background: color-mix(in srgb, var(--ink) 80%, transparent);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .asset-log :global(.old) {
    opacity: 0.35;
  }
  @media (max-width: 1100px) {
    .asset-log {
      display: none;
    }
  }
  .toasts {
    position: fixed;
    top: calc(var(--header-h) + env(safe-area-inset-top) + var(--space-4));
    right: var(--gutter);
    z-index: 60;
    width: min(22rem, 100% - 2 * var(--gutter));
    pointer-events: none;
  }
  .toasts :global(.toast) {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--panel);
    border: 1px solid var(--wolf);
    border-left-width: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .toasts :global(.toast) {
      animation: toast-in 0.45s var(--ease-pop);
    }
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.96);
    }
  }
  .toasts :global(.toast-kicker) {
    color: var(--wolf);
  }
  .toasts :global(.toast-title) {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
  }
  .toasts :global(.toast-detail) {
    color: var(--bone-soft);
    font-size: var(--step--1);
  }
  .flash {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: var(--bone);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flash:global(.is-flashing) {
      animation: flash 0.5s ease-out;
    }
  }
  @keyframes flash {
    from {
      opacity: 0.55;
    }
  }
</style>
