---
/* A two-state toggle that overrides the system theme. Without JS the button is
   hidden and the site follows prefers-color-scheme. */
---

<button class="theme-toggle" type="button" aria-pressed="false" hidden>
  <span class="visually-hidden">Light theme</span>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 7a5 5 0 0 1 0 10z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    const root = document.documentElement;
    const isLight = () =>
      root.dataset['theme'] === 'light' ||
      (!root.dataset['theme'] && matchMedia('(prefers-color-scheme: light)').matches);
    const sync = () => button.setAttribute('aria-pressed', String(isLight()));
    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const next = isLight() ? 'dark' : 'light';
      root.dataset['theme'] = next;
      const bar = getComputedStyle(root).getPropertyValue('--ink').trim();
      for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
        meta.setAttribute('content', bar);
      }
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page view only */
      }
      sync();
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    color: var(--dim);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    color: var(--bone);
    border-color: var(--dim);
  }
</style>
