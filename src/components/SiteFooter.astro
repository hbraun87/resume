---
import profile from '../content/profile.json';
import { buildInfo } from '../lib/build';
import { visibleLinks } from '../lib/profile';

const build = buildInfo();
const repo = 'https://github.com/hbraun87/resume';
const showBuildLine = profile.footer.buildLine !== 'hidden';
const showPrivacyLine = profile.footer.privacyLine !== 'hidden';
---

<footer class="site-footer">
  <div class="container inner">
    <ul class="links">
      <li>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </li>
      {visibleLinks(profile.links).map((link) => (
        <li>
          <a href={link.url} rel="noopener">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    {showBuildLine && (
      <p class="mono meta">
        Built with Astro ·{' '}
        <a href={repo} rel="noopener">
          Source on GitHub
        </a>
        {build.shortSha && (
          <>
            {' '}
            · Build <a href={`${repo}/commit/${build.sha}`}>{build.shortSha}</a>
          </>
        )}{' '}
        · {build.date}
      </p>
    )}
    {showPrivacyLine && <p class="mono meta">No cookies, no trackers, no third-party requests.</p>}
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    padding-block: var(--space-12) calc(var(--space-12) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    color: var(--dim);
  }
  .inner {
    display: grid;
    gap: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--bone);
  }
  .meta a {
    color: inherit;
  }
</style>
