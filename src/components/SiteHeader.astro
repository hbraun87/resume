---
import profile from '../content/profile.json';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

// Profile, Games, R&D and Contact return with the home page sections they
// point to (docs/brief/10-loading-screen-spec.md); a link to a missing
// section is a dead link, and the system tests fail on those.
const nav: { label: string; href: string }[] = [];
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <span class="logo" aria-hidden="true">
        {initials}
      </span>
      <span class="mono name">{profile.name}</span>
    </a>
    {nav.length > 0 && (
      <nav aria-label="Main">
        <ul class="mono">
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="actions">
      <a class="cta mono" href={`mailto:${profile.email}`}>
        Email
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-h);
  }
  .brand {
    margin-inline-end: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--bone);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--wolf);
    color: var(--on-wolf);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 900;
    clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 0 100%);
  }
  .name {
    color: var(--bone);
  }
  nav ul {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--dim);
    text-decoration: none;
    padding-block: var(--space-3);
  }
  nav a:hover {
    color: var(--bone);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cta {
    display: inline-grid;
    place-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    background: var(--wolf);
    color: var(--on-wolf);
    text-decoration: none;
    font-weight: 600;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }
  .cta:hover {
    background: var(--wolf-strong);
    color: var(--on-wolf);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    /* Hidden visually, but it stays the link's accessible name. */
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
