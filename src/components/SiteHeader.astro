---
import profile from '../content/profile.json';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

// The home page sections (docs/brief/10-loading-screen-spec.md). On the home
// page the script marks the one in view with aria-current.
const nav = [
  { label: 'Profile', href: url('/#profile') },
  { label: 'Games', href: url('/#games') },
  { label: 'R&D', href: url('/#research') },
  { label: 'Contact', href: url('/#contact') },
];
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <span class="logo" aria-hidden="true">
        {initials}
      </span>
      <span class="mono name">{profile.name}</span>
    </a>
    <nav aria-label="Main" data-nav>
      <ul class="mono">
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="cta mono" href={`mailto:${profile.email}`}>
        Email
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-h);
  }
  .brand {
    margin-inline-end: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--bone);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--wolf);
    color: var(--on-wolf);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 900;
    clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 0 100%);
  }
  .name {
    color: var(--bone);
  }
  nav ul {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--dim);
    text-decoration: none;
    padding-block: var(--space-3);
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--bone);
  }
  nav a::before {
    content: '▸' / '';
    margin-inline-end: 0.35em;
    color: var(--wolf);
    opacity: 0;
  }
  nav a[aria-current]::before {
    opacity: 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  /* The clipped shape is painted by ::before, so the focus outline is not clipped too. */
  .cta {
    position: relative;
    isolation: isolate;
    display: inline-grid;
    place-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    color: var(--on-wolf);
    text-decoration: none;
    font-weight: 600;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--wolf);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }
  .cta:hover {
    color: var(--on-wolf);
  }
  .cta:hover::before {
    background: var(--wolf-strong);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    /* Hidden visually, but it stays the link's accessible name. */
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
