---
/* A grid of thumbnails. Each links to a large WebP, so it works without
   JavaScript; src/lib/lightbox.ts opens the links in a shared <dialog>. */
import { getImage, Picture } from 'astro:assets';
import type { Media } from '../lib/schema';
import { projectImage } from '../lib/media';

type ImageItem = Extract<Media, { type: 'image' }>;

interface Props {
  /** The experience id; images live in src/assets/projects/<id>/. */
  entryId: string;
  items: ImageItem[];
  /** Names the gallery and its lightbox, e.g. "Toren screenshots". */
  label: string;
}

const { entryId, items, label } = Astro.props;
const slides = await Promise.all(
  items.map(async (item) => {
    const image = projectImage(entryId, item.src);
    const full = await getImage({
      src: image,
      width: Math.min(image.width, 2400),
      format: 'webp',
    });
    return { item, image, full: full.src };
  }),
);
---

<ul class="gallery" data-gallery={label} aria-label={label}>
  {slides.map(({ item, image, full }) => (
    <li>
      <figure>
        <a class="thumb" href={full} data-lightbox data-caption={item.caption}>
          <Picture
            src={image}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[400, 800].filter((w) => w <= image.width)}
            sizes="(min-width: 60rem) 24rem, (min-width: 36rem) 50vw, 100vw"
            loading="lazy"
          />
        </a>
        {(item.caption || item.credit) && (
          <figcaption>
            {item.caption}
            {item.credit && <span class="mono credit">{item.credit}</span>}
          </figcaption>
        )}
      </figure>
    </li>
  ))}
</ul>

<script>
  import { enhanceGalleries } from '../lib/lightbox';
  enhanceGalleries();
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--sunken);
    border: 1px solid var(--line);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover {
    border-color: var(--wolf);
  }
  figcaption {
    margin-top: var(--space-2);
    color: var(--dim);
    font-size: var(--step--1);
  }
  .credit {
    display: block;
    margin-top: var(--space-1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .thumb :global(img) {
      transition: transform var(--dur-med) var(--ease-out);
    }
    .thumb:hover :global(img) {
      transform: scale(1.03);
    }
  }

  /* The lightbox is built by script, so its styles are global. */
  :global(.lightbox) {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(var(--space-4), env(safe-area-inset-top)) var(--gutter)
      max(var(--space-4), env(safe-area-inset-bottom));
    border: 0;
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    color: var(--bone);
    touch-action: pan-y;
  }
  :global(.lightbox[open]) {
    display: grid;
    grid-template: 1fr auto / auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
  }
  :global(.lightbox::backdrop) {
    background: rgb(0 0 0 / 0.6);
  }
  :global(.lightbox figure) {
    grid-area: 1 / 2;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    min-height: 0;
    max-height: 100%;
  }
  :global(.lightbox img) {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
  }
  :global(.lightbox figcaption) {
    color: var(--bone-soft);
    text-align: center;
  }
  :global(.lightbox-count) {
    grid-area: 2 / 2;
    justify-self: center;
    color: var(--dim);
  }
  :global(.lightbox button) {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--bone);
    cursor: pointer;
  }
  :global(.lightbox button:hover) {
    border-color: var(--wolf);
  }
  :global(.lightbox button[hidden]) {
    display: none;
  }
  :global(.lightbox-prev) {
    grid-area: 1 / 1;
  }
  :global(.lightbox-next) {
    grid-area: 1 / 3;
  }
  :global(.lightbox-close) {
    position: absolute;
    top: max(var(--space-4), env(safe-area-inset-top));
    right: max(var(--space-4), env(safe-area-inset-right));
  }
  /* Phones: arrows move under the image so it gets the full width. */
  @media (max-width: 40rem) {
    :global(.lightbox[open]) {
      grid-template: 1fr auto / 1fr auto 1fr;
    }
    :global(.lightbox figure) {
      grid-area: 1 / 1 / 2 / 4;
    }
    :global(.lightbox-prev) {
      grid-area: 2 / 1;
      justify-self: end;
    }
    :global(.lightbox-count) {
      grid-area: 2 / 2;
      align-self: center;
    }
    :global(.lightbox-next) {
      grid-area: 2 / 3;
    }
  }
</style>
