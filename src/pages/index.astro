---
/* The home page: a game loading sequence (docs/brief/10-loading-screen-spec.md).
   Every stage is real HTML; the script only adds the loading layer on top. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootHero from '../components/home/BootHero.astro';
import Finale from '../components/home/Finale.astro';
import LevelSelect from '../components/home/LevelSelect.astro';
import LoadingHud from '../components/home/LoadingHud.astro';
import ProfileStage from '../components/home/ProfileStage.astro';
import ResearchLab from '../components/home/ResearchLab.astro';
import { games, research } from '../lib/experiences';

const entries = (await getCollection('experiences')).map(({ data }) => data);
const titles = games(entries);
const papers = research(entries);
---

<Base>
  <BootHero titles={titles.length} researchCount={papers.length} />
  <ProfileStage titles={titles.length} researchCount={papers.length} />
  <LevelSelect entries={titles} />
  <ResearchLab entries={papers} />
  <Finale />
  <LoadingHud />
</Base>

<script>
  import { initHome } from '../lib/home';
  initHome();
</script>
