{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "game",
              "prototype",
              "tool",
              "research",
              "jam",
              "other"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "featured",
              "selected",
              "archive"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "shipped",
              "released-early-access",
              "in-development",
              "prototype",
              "unreleased",
              "published"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "hidden",
              "draft"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "studio": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
              },
              "end": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
                  },
                  {
                    "type": "string",
                    "const": "present"
                  }
                ]
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "platformGroup": {
            "type": "string",
            "enum": [
              "pc",
              "mobile",
              "playstation",
              "vr",
              "ar"
            ]
          },
          "alsoOn": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pc",
                "mobile",
                "playstation",
                "vr",
                "ar"
              ]
            }
          },
          "engine": {
            "type": "string"
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "teamSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "awards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "year": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "caseStudy": {
            "type": "object",
            "properties": {
              "challenge": {
                "type": "string",
                "minLength": 1
              },
              "contributions": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1
                    },
                    "media": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "heading",
                    "body"
                  ]
                }
              },
              "deepDive": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "challenge",
              "contributions",
              "outcome"
            ]
          },
          "cover": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^[\\w.-]+\\.(jpe?g|png|webp|avif)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "coverLoop": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^[\\w.-]+\\.(gif|mp4|webm)$"
              }
            },
            "required": [
              "src"
            ]
          },
          "media": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "youtube"
                    },
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "poster": {
                      "type": "string",
                      "pattern": "^[\\w.-]+\\.(jpe?g|png|webp|avif)$"
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "title"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "src": {
                      "type": "string",
                      "pattern": "^[\\w.-]+\\.(jpe?g|png|webp|avif)$"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "caption": {
                      "type": "string"
                    },
                    "credit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "src",
                    "alt"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "gif"
                    },
                    "src": {
                      "type": "string",
                      "pattern": "^[\\w.-]+\\.gif$"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "caption": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "src",
                    "alt"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "video"
                    },
                    "src": {
                      "type": "string",
                      "pattern": "^[\\w.-]+\\.(mp4|webm)$"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "caption": {
                      "type": "string"
                    },
                    "loop": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "src",
                    "alt"
                  ]
                }
              ]
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "steam",
                    "meta",
                    "app-store",
                    "google-play",
                    "website",
                    "press",
                    "paper",
                    "doi",
                    "video",
                    "repo",
                    "talk",
                    "other"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "kind",
                "label",
                "url"
              ]
            }
          },
          "publication": {
            "type": "object",
            "properties": {
              "venue": {
                "type": "string"
              },
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "abstract": {
                "type": "string"
              },
              "peerReviewed": {
                "type": "boolean"
              }
            }
          },
          "legacyPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\/"
            }
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "tier",
          "status",
          "visibility",
          "role",
          "summary"
        ]
      }
    }
  },
  "required": [
    "experiences"
  ],
  "title": "Henry Braun portfolio experiences",
  "description": "Generated from src/lib/schema.ts by `npm run schema`. Do not edit by hand."
}
