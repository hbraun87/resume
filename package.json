{
  "name": "henrybraun-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Henry Braun's portfolio: a static Astro site deployed to GitHub Pages.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "standalone": "node scripts/standalone.mjs",
    "preview": "astro preview",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:extended": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "schema": "node scripts/gen-schema.mjs",
    "new:experience": "node scripts/new-experience.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:static": "astro check && eslint . && prettier --check . && node scripts/gen-schema.mjs --verify && node scripts/check-content.mjs && vitest run --coverage",
    "check": "npm run check:static && npm run build && npm run test:e2e",
    "check:extended": "npm run check:static && npm run build && npm run test:e2e:extended"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "astro": "7.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
